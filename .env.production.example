# =============================================================
#  ALDEF POS - Contoh environment produksi
#
#  SALIN berkas ini menjadi .env di server, lalu isi sendiri
#  bagian yang bertanda GANTI_. Jangan pernah menuliskan nilai
#  aslinya di sini - berkas ini terlacak git dan reponya publik.
#
#  APP_KEY dibuat di server, bukan disalin:
#      php artisan key:generate
# =============================================================

APP_NAME="ALDEF POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://pos.aldeftech.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_nama_database
DB_USERNAME=GANTI_user_database
DB_PASSWORD=GANTI_password_database

SESSION_DRIVER=database
SESSION_LIFETIME=600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pos.aldeftech.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pengaturan khusus POS ---
# Lebar struk termal: 58 atau 80 (mm)
POS_RECEIPT_WIDTH=80
